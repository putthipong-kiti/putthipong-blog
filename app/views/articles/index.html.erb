<div class="flex justify-center p-5">
  <h1 class="text-4xl font-medium">Articles</h1>
</div>

<div class="flex justify-center p-2 text-xl">
  Our blog has <%= Article.public_count %> articles and counting!
</div>

<div class="flex justify-end">
<%= link_to "New Article", new_article_path, class:"px-8 py-3 gap-4 text-lg text-center text-white bg-green-600 rounded-xl transition duration-300 hover:bg-green-700" %>
</div>

<ul class="flex flex-row gap-5">
  <% @articles.each do |article| %>
    <% unless article.archived? %>
      <li>
        <%= link_to article.title, article, class:"flex items-center p-10 gap-4 text-lg text-center text-white bg-indigo-600 rounded-xl transform transition-all duration-300 hover:scale-105 hover:bg-indigo-700 hover:shadow-xl" %>
      </li>
    <% end %>
  <% end %>
</ul>

