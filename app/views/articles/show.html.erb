<div class="flex justify-between">
  <div class="flex justify-start">
    <%= link_to "Back to Article", articles_path, class:"px-5 py-2 gap-4 text-lg text-center text-black bg-gray-100 rounded-xl transform transition-all duration-300 hover:scale-105" %>
  </div>
  <div class="flex justify-start gap-3">
    <%= link_to "Edit", edit_article_path(@article), class:"px-5 py-2 gap-4 text-lg text-center text-black bg-yellow-100 rounded-xl transform transition-all duration-300 hover:scale-105" %>
    <%= link_to "Delete", article_path(@article), data: {
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure?"
                  }, class:"px-5 py-2 gap-4 text-lg text-center text-black bg-red-100 rounded-xl transform transition-all duration-300 hover:scale-105" %>
  </div>
</div>
<div class="container w-3/4 p-8 mx-auto my-5 divide-y divide-solid divide-y-2">
    <div class="text-6xl font-bold py-5"><%= @article.title %></div>
    <div class="text-xl py-5"><%= @article.body %></div>
  <div class="py-10">
    <h2 class="text-3xl font-bold">Comments</h2>
    <%= render @article.comments %>
  </div>
  <div>
    <h2 class="text-3xl font-bold py-5">Add a comment</h2>
    <%= render "comments/form", article: @article %>
  </div>
</div>


